# ===================================================================
# College Bus Tracking App - Local Development Environment
# ===================================================================
PORT=4000
NODE_ENV=development

# MongoDB Connection:
# If you don't have local MongoDB running, the server automatically
# falls back to a built-in in-memory MongoDB database!
MONGO_URI=mongodb://127.0.0.1:27017/campus_bus

# JWT Secret for signing auth tokens (change this in production)
JWT_SECRET=college-bus-secret-key-local-dev-2026
JWT_EXPIRES=7d

# Frontend Origin for CORS
CLIENT_ORIGIN=http://localhost:5173

# Average Bus Speed in km/h for ETA calculation
AVG_BUS_SPEED_KMH=25
