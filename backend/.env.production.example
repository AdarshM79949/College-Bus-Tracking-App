# ===================================================================
# College Bus Tracking App - Production Backend Environment (Render)
# ===================================================================
# Copy these key-value pairs into your Render Web Service Environment Variables:

NODE_ENV=production
PORT=10000

# CORS Client Origin: Set to your live Vercel app URL (or * to allow all origins)
CLIENT_ORIGIN=*

# JWT Signing Secret: Use a random 32+ character string
JWT_SECRET=super-secret-college-bus-jwt-key-2026-production

# JWT Expiration
JWT_EXPIRES=7d

# Average Bus Speed in km/h for live ETA calculations
AVG_BUS_SPEED_KMH=25

# MongoDB Connection String:
# Leave blank to automatically use the built-in in-memory database for zero-config demos,
# or paste your MongoDB Atlas connection URI:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/college_bus?retryWrites=true&w=majority
